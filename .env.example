# Frontend API base URL (safe to expose; no secrets here)
VITE_API_URL=http://localhost:5000

# Groq AI (optional)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Backend authentication secret: replace with a long random value
AUTH_SECRET=replace_with_a_long_random_secret_before_deployment
PORT=5000

# MySQL connection settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=heritagecare
